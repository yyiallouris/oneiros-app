{
  "type": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$description": "Brand/display font for the Oneiros wordmark and splash title.",
        "$value": "Cormorant Garamond"
      },
      "body": {
        "$type": "fontFamily",
        "$description": "Primary UI/body font. Greek-safe and used for app copy and user-generated text.",
        "$value": "Alegreya Sans"
      }
    },
    "font-style": {
      "regular": {
        "$type": "string",
        "$description": "Alegreya Sans regular style.",
        "$value": "Regular"
      },
      "medium": {
        "$type": "string",
        "$description": "Alegreya Sans medium style.",
        "$value": "Medium"
      },
      "semibold": {
        "$type": "string",
        "$description": "Cormorant Garamond semibold display style.",
        "$value": "SemiBold"
      },
      "bold": {
        "$type": "string",
        "$description": "Alegreya Sans bold style.",
        "$value": "Bold"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$description": "Tiny labels, tab labels, metadata.",
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "sm": {
        "$type": "dimension",
        "$description": "Secondary labels, helper text, compact metadata.",
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "md": {
        "$type": "dimension",
        "$description": "Default body text, inputs, common UI copy.",
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "lg": {
        "$type": "dimension",
        "$description": "Large labels and compact section headings.",
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "xl": {
        "$type": "dimension",
        "$description": "Navigation titles, list/item titles, section titles.",
        "$value": {
          "value": 22,
          "unit": "px"
        }
      },
      "xxl": {
        "$type": "dimension",
        "$description": "Screen titles and onboarding headings.",
        "$value": {
          "value": 28,
          "unit": "px"
        }
      },
      "xxxl": {
        "$type": "dimension",
        "$description": "Large screen titles and lock/password screen headings.",
        "$value": {
          "value": 36,
          "unit": "px"
        }
      },
      "splash-title": {
        "$type": "dimension",
        "$description": "Live loading splash title size for Oneiros.",
        "$value": {
          "value": 34,
          "unit": "px"
        }
      },
      "splash-subtitle": {
        "$type": "dimension",
        "$description": "Live loading splash subtitle size for Dream Journal.",
        "$value": {
          "value": 18,
          "unit": "px"
        }
      }
    },
    "line-height": {
      "tight": {
        "$type": "number",
        "$description": "Tight line-height ratio used for compact display text.",
        "$value": 1.2
      },
      "normal": {
        "$type": "number",
        "$description": "Normal line-height ratio used for general readable UI copy.",
        "$value": 1.5
      },
      "relaxed": {
        "$type": "number",
        "$description": "Relaxed line-height ratio used for long-form dream text and dense descriptions.",
        "$value": 1.8
      }
    },
    "letter-spacing": {
      "none": {
        "$type": "dimension",
        "$description": "Default app letter spacing.",
        "$value": {
          "value": 0,
          "unit": "px"
        }
      },
      "splash-title": {
        "$type": "dimension",
        "$description": "Live loading splash title letter spacing.",
        "$value": {
          "value": 0.8,
          "unit": "px"
        }
      },
      "splash-subtitle": {
        "$type": "dimension",
        "$description": "Live loading splash subtitle letter spacing.",
        "$value": {
          "value": 0.4,
          "unit": "px"
        }
      }
    }
  }
}
