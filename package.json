{
  "name": "oneiros-app",
  "version": "1.2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:dev:tunnel": "expo start --dev-client --tunnel",
    "start:dev:port": "expo start --dev-client --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "JEST_DISABLE_WATCHMAN=1 jest --watchman=false",
    "test:all": "JEST_DISABLE_WATCHMAN=1 jest --runInBand --watchman=false",
    "test:coverage": "JEST_DISABLE_WATCHMAN=1 jest --coverage --runInBand --watchman=false",
    "test:one": "JEST_DISABLE_WATCHMAN=1 jest --runInBand --watchman=false",
    "test:flows": "JEST_DISABLE_WATCHMAN=1 jest __tests__/flows --watchman=false",
    "verify:design-release": "node -r ./scripts/register-typescript.cjs scripts/lib/designReleaseFingerprint.ts",
    "test:live-ai": "RUN_LIVE_AI_TESTS=1 JEST_DISABLE_WATCHMAN=1 jest __tests__/live --runInBand --watchman=false",
    "test:live-ai-quality": "RUN_LIVE_AI_TESTS=1 RUN_LIVE_AI_QUALITY_TESTS=1 JEST_DISABLE_WATCHMAN=1 jest __tests__/live --runInBand --watchman=false",
    "guard:ai-entitlements-gateway-deploy": "node -r ./scripts/register-typescript.cjs scripts/guards/assert-reflective-question-gateway-deploy.ts",
    "deploy:ai-entitlements-gateway": "npm run guard:ai-entitlements-gateway-deploy && supabase functions deploy ai-entitlements-gateway",
    "review:reflective-essays-phase1": "node -r ./scripts/register-typescript.cjs scripts/live/run-reflective-essay-phase1-regression.ts",
    "review:reflective-essays-anti-coherence": "REFLECTIVE_ESSAY_FIXTURE=testing/live-scenarios/reflective-essays-anti-coherence-stress-set.v1.json node -r ./scripts/register-typescript.cjs scripts/live/run-reflective-essay-phase1-regression.ts",
    "review:reflective-essays-phase2": "REFLECTIVE_ESSAY_CONTEXT_EXPERIMENT=phase2 node -r ./scripts/register-typescript.cjs scripts/live/run-reflective-essay-phase1-regression.ts",
    "review:reflective-essays-phase2-anti-coherence": "REFLECTIVE_ESSAY_CONTEXT_EXPERIMENT=phase2 REFLECTIVE_ESSAY_FIXTURE=testing/live-scenarios/reflective-essays-anti-coherence-stress-set.v1.json node -r ./scripts/register-typescript.cjs scripts/live/run-reflective-essay-phase1-regression.ts",
    "review:reflective-essays-field-map": "node -r ./scripts/register-typescript.cjs scripts/live/run-reflective-essay-field-map-spike.ts",
    "review:reflective-essays-field-map-anti-coherence": "REFLECTIVE_ESSAY_FIXTURE=testing/live-scenarios/reflective-essays-anti-coherence-stress-set.v1.json node -r ./scripts/register-typescript.cjs scripts/live/run-reflective-essay-field-map-spike.ts",
    "review:reflective-questions-active": "node -r ./scripts/register-typescript.cjs scripts/live/rd/reflective-questions/run-active-candidate.ts",
    "benchmark:same-call-minimal-gate1": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-same-call-minimal-gate1.ts",
    "benchmark:same-call-minimal-final-24": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-same-call-minimal-final-24.ts",
    "benchmark:same-call-minimal-v12-paired": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-same-call-minimal-v12-paired.ts",
    "benchmark:question-integrity-gate-phase1": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-question-integrity-gate-phase1.ts",
    "benchmark:question-repair-phase2": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-question-repair-phase2.ts",
    "validate:reflective-question-production": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-production-pipeline-bounded-validation.ts",
    "benchmark:reflective-v101-production-diagnostic": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-v101-production-diagnostic.ts",
    "benchmark:reflective-v102-surgical-anchors": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-v102-surgical-anchor-evaluation.ts",
    "benchmark:reflective-v103-enacted-relation": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-v103-enacted-relation-evaluation.ts",
    "benchmark:reflective-v104-imaginal-handoff": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-v104-imaginal-handoff-evaluation.ts",
    "benchmark:reflective-v105-source-ownership": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-v105-source-ownership-evaluation.ts",
    "benchmark:adaptive-reflective-openings": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-adaptive-openings-feasibility.ts",
    "benchmark:adaptive-reflective-openings-shot2": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-adaptive-openings-shot2.ts",
    "benchmark:adaptive-reflective-openings-shot3-final": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-adaptive-openings-shot3-final.ts",
    "review:adaptive-reflective-openings-shot3-final": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/finalize-adaptive-openings-shot3.ts",
    "benchmark:adaptive-openings-shot3-vs-production": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-adaptive-openings-shot3-vs-production-confirmation.ts",
    "review:adaptive-openings-shot3-vs-production": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/finalize-adaptive-openings-shot3-vs-production-confirmation.ts",
    "sanity:reflective-v103-production": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-questions/run-v103-production-sanity.ts",
    "benchmark:reflective-dialogue-v1": "node -r ./scripts/register-typescript.cjs scripts/live/reflective-dialogue/run-v1-trajectory-benchmark.ts",
    "test:live-production-baseline": "bash scripts/live/run-production-baseline.sh",
    "site:preview": "python3 -m http.server 4173 -d site",
    "typecheck": "tsc --noEmit",
    "build:mythic-prompt-index": "npx tsx scripts/build-mythic-prompt-index.ts",
    "build:catalog-id-enums": "npx tsx scripts/build-catalog-id-enums.ts",
    "build:interpretive-catalogs": "npm run build:mythic-prompt-index && npm run build:catalog-id-enums",
    "test:5-dream-acceptance": "bash scripts/run-5-dream-acceptance.sh",
    "sync:myth-naturalistic-benchmark": "npx tsx scripts/sync-naturalistic-myth-benchmark-jsonl.ts",
    "review:myth-naturalistic-dataset": "npx tsx scripts/build-naturalistic-myth-dataset-review-packet.ts",
    "test:myth-naturalistic-benchmark": "bash scripts/run-naturalistic-myth-benchmark.sh",
    "sync:global-archetype-benchmark": "npx tsx scripts/sync-global-archetype-benchmark-jsonl.ts",
    "review:global-archetype-dataset": "npx tsx scripts/build-global-archetype-dataset-review-packet.ts",
    "reconcile:global-archetype-benchmark": "npx tsx scripts/reconcile-global-archetype-benchmark.ts",
    "rerun:global-archetype-primary": "npx tsx scripts/run-global-archetype-primary-rerun.ts",
    "test:global-archetype-benchmark": "bash scripts/run-global-archetype-benchmark.sh",
    "test:patch-f-stability": "bash scripts/run-patch-f-stability.sh",
    "detox:build:android": "detox build -c android.emu.debug",
    "detox:test:android": "detox test -c android.emu.debug"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
