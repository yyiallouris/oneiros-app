# Copy to .env and fill in real values. Never commit .env.
# Required for local dev and for EAS builds (or set via eas secret:create).

# Supabase (required)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenAI — key only for direct openai.com in dev; production uses CUSTOM_GPT_ENDPOINT (proxy).
# With openai-proxy, model ids are **not** chosen here — set them in supabase/functions/openai-proxy/task-config.ts.
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_CUSTOM_GPT_ENDPOINT=https://your-project.supabase.co/functions/v1/openai-proxy

# Optional
APP_SCHEME=oneiros-dream-journal
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_APPLE_SUBSCRIPTION_MONTHLY_PRODUCT_ID=oneiros_premium_monthly
EXPO_PUBLIC_APPLE_SUBSCRIPTION_YEARLY_PRODUCT_ID=oneiros_premium_yearly
EXPO_PUBLIC_APPLE_DEEPER_SUBSCRIPTION_MONTHLY_PRODUCT_ID=oneiros_deeper_monthly
EXPO_PUBLIC_APPLE_DEEPER_SUBSCRIPTION_YEARLY_PRODUCT_ID=oneiros_deeper_yearly
EXPO_PUBLIC_GOOGLE_SUBSCRIPTION_PRODUCT_ID=oneiros_premium
EXPO_PUBLIC_GOOGLE_DEEPER_SUBSCRIPTION_PRODUCT_ID=oneiros_deeper
EXPO_PUBLIC_GOOGLE_SUBSCRIPTION_MONTHLY_BASE_PLAN_ID=monthly
EXPO_PUBLIC_GOOGLE_SUBSCRIPTION_YEARLY_BASE_PLAN_ID=yearly
